{
  "name": "chat-app-desktop",
  "version": "2.0.7",
  "description": "Chat App",
  "author": "Chat App",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "predist": "node scripts/benchmark-games.cjs --build-helper && node scripts/build-native-helper.cjs",
    "dist": "electron-builder --win dir --x64 --publish never && node scripts/benchmark-games.cjs --package-x64"
  },
  "dependencies": {
    "adm-zip": "0.6.1"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.1"
  },
  "overrides": {
    "minimatch@>=7 <11": "11.0.9"
  },
  "build": {
    "appId": "app.chatapp.desktop",
    "productName": "Chat App",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "asarUnpack": [
      "helpers/*.exe"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "*.cjs",
      "helpers/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json",
      "spotify-config.json",
      "native-update-key.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "bundled-app",
        "filter": [
          "index.html",
          "app.js",
          "music-range-worker.js",
          "styles.css",
          "call-config.js",
          "desktop-capabilities.json",
          "build-info.json",
          "_headers",
          ".nojekyll",
          "THIRD-PARTY.md",
          "activities/**/*",
          "activity-modules/**/*",
          "assets/**/*",
          "call-modules/**/*",
          "css/**/*",
          "js/**/*",
          "music/**/*",
          "vendor/**/*",
          "backend/functions/calendar-recurrence.js",
          "desktop/assets/chat-app.png",
          "!**/*.pem",
          "!**/node_modules{,/**/*}"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/chat-app.ico"
    },
    "portable": {
      "artifactName": "Chat App.exe"
    }
  }
}
